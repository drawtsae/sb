# Environment variables for the Portainer stack (docker-compose.yml).
# Enter them in the stack's "Environment variables" section, or load this file there.
# Never commit real values.

# Image tag from ghcr.io/drawtsae/sb: latest, sha-<commit>, or a release like 1.2.3
IMAGE_TAG=latest
# Host port the app is published on (your reverse proxy forwards to it)
APP_PORT=3000

# First admin, created on first start when there are no users yet.
# At least 8 characters; anything containing "change-me" is refused.
# Remove ADMIN_PASSWORD from the stack after you can log in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Max size per uploaded music file, in MB. Your reverse proxy's body limit must allow it.
MAX_UPLOAD_MB=100

# Login cookie gets the Secure flag (needs HTTPS). Set false only to test over plain http.
COOKIE_SECURE=true

# How many reverse proxies you control sit in front of the app (1 for Nginx Proxy Manager,
# Traefik or a Cloudflare Tunnel). 0 = app published directly: X-Forwarded-For is ignored.
TRUST_PROXY_HOPS=1
