# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=soundboard.example.com
ACME_EMAIL=you@example.com
ADMIN_EMAIL=admin@example.com
# At least 8 characters; the placeholder below (anything containing "change-me") is refused.
ADMIN_PASSWORD=change-me-to-a-long-random-password
MAX_UPLOAD_MB=100
