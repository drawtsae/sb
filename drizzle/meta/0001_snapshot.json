        "cues_volume_check": {
          "name": "cues_volume_check",
          "value": "\"cues\".\"volume\" BETWEEN 0 AND 100"
        },
        "cues_kind_check": {
          "name": "cues_kind_check",
          "value": "\"cues\".\"kind\" IN ('song','background')"
        },
        "cues_on_end_check": {
          "name": "cues_on_end_check",
          "value": "\"cues\".\"on_end\" IN ('resume_background','stop')"
        },
        "cues_song_id_check": {
          "name": "cues_song_id_check",
          "value": "\"cues\".\"kind\" <> 'song' OR \"cues\".\"song_id\" IS NOT NULL"
        },
        "cues_end_after_start_check": {
          "name": "cues_end_after_start_check",
          "value": "\"cues\".\"end_sec\" IS NULL OR \"cues\".\"end_sec\" > \"cues\".\"start_sec\""
        },
        "cues_start_check": {
          "name": "cues_start_check",
          "value": "\"cues\".\"start_sec\" >= 0"
        }
